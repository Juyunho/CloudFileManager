<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/CloudFileManager.Core/CloudFileManager.Core.csproj" />
    <Compile Remove="ColdStartProbe/**/*.cs" />
    <None Remove="ColdStartProbe/**" />
    <ProjectReference Include="ColdStartProbe/ColdStartProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyColdStartProbe" AfterTargets="Build">
    <ItemGroup><ProbeFiles Include="$(MSBuildProjectDirectory)/ColdStartProbe/bin/$(Configuration)/$(TargetFramework)/**/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)" DestinationFiles="@(ProbeFiles->'$(OutDir)ColdStartProbeAssets/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
